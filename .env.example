# 관리자 로그인 (README의 "관리자 계정 만들기" 참고)
ADMIN_ID=
# 비밀번호. 둘 중 하나만 넣는다: ADMIN_PASSWORD(그대로) 또는 ADMIN_PASSWORD_HASH(npm run hash-password로 만든 scrypt:...:... 값)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# 저장 기록에 남길 이름 (예: 임유진)
ADMIN_NAME=
# (선택) 로그인 쿠키 서명용 임의 문자열 (32자 이상). 비우면 비밀번호·Supabase 키에서 만든다
SESSION_SECRET=

# 데이터 저장소 (Supabase). 비워 두면 배포본은 함께 넣은 초기 데이터만 보여 주는 보기 전용이 됩니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
